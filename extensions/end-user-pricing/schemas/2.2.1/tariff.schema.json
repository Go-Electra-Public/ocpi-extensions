{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Go-Electra-Public/ocpi-extensions/main/extensions/end-user-pricing/schemas/2.2.1/tariff.schema.json",
  "title": "OCPI 2.2.1 Tariff",
  "description": "The standard OCPI 2.2.1 Tariff object, unchanged. Used as end_user_tariff by the end-user pricing display extension. Only the members the extension relies on are constrained; others are permitted and ignored.",
  "type": "object",
  "properties": {
    "country_code": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
    "party_id": { "type": "string", "pattern": "^[A-Za-z0-9]{3}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 36 },
    "currency": {
      "type": "string",
      "pattern": "^[A-Za-z]{3}$",
      "description": "ISO 4217 code of the currency the eMSP bills the driver in."
    },
    "type": {
      "type": "string",
      "enum": ["AD_HOC_PAYMENT", "PROFILE_CHEAP", "PROFILE_FAST", "PROFILE_GREEN", "REGULAR"]
    },
    "tariff_alt_text": {
      "type": "array",
      "items": { "$ref": "#/$defs/displayText" },
      "description": "Ignored for rendering by the CPO. See the rendering section of the spec."
    },
    "tariff_alt_url": { "type": "string", "format": "uri" },
    "min_price": { "$ref": "price.schema.json" },
    "max_price": { "$ref": "price.schema.json" },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tariffElement" },
      "description": "MUST contain at least one element. A Tariff with no elements MUST NOT be sent."
    },
    "start_date_time": { "type": "string", "format": "date-time" },
    "end_date_time": { "type": "string", "format": "date-time" },
    "energy_mix": { "type": "object" },
    "last_updated": { "type": "string", "format": "date-time" }
  },
  "required": ["country_code", "party_id", "id", "currency", "elements", "last_updated"],
  "$defs": {
    "displayText": {
      "type": "object",
      "properties": {
        "language": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
        "text": { "type": "string", "maxLength": 512 }
      },
      "required": ["language", "text"]
    },
    "tariffElement": {
      "type": "object",
      "properties": {
        "price_components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/priceComponent" }
        },
        "restrictions": { "$ref": "#/$defs/tariffRestrictions" }
      },
      "required": ["price_components"]
    },
    "priceComponent": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ENERGY", "FLAT", "PARKING_TIME", "TIME"],
          "description": "TariffDimensionType. All four values are renderable by the CPO."
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "description": "Price per unit, EXCLUDING VAT, per standard OCPI 2.2.1 semantics."
        },
        "vat": {
          "type": "number",
          "minimum": 0,
          "description": "VAT percentage. SHOULD be provided; without it the CPO displays the excluding-VAT amount as-is."
        },
        "step_size": { "type": "integer", "minimum": 0 }
      },
      "required": ["type", "price", "step_size"]
    },
    "tariffRestrictions": {
      "type": "object",
      "description": "Standard OCPI 2.2.1 TariffRestrictions. min_duration on a parking component is rendered as a threshold; complex combinations may not be rendered.",
      "properties": {
        "start_time": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "end_time": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "start_date": { "type": "string" },
        "end_date": { "type": "string" },
        "min_kwh": { "type": "number", "minimum": 0 },
        "max_kwh": { "type": "number", "minimum": 0 },
        "min_current": { "type": "number", "minimum": 0 },
        "max_current": { "type": "number", "minimum": 0 },
        "min_power": { "type": "number", "minimum": 0 },
        "max_power": { "type": "number", "minimum": 0 },
        "min_duration": { "type": "integer", "minimum": 0 },
        "max_duration": { "type": "integer", "minimum": 0 },
        "day_of_week": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY"]
          }
        },
        "reservation": {
          "type": "string",
          "enum": ["RESERVATION", "RESERVATION_EXPIRES"]
        }
      }
    }
  }
}
