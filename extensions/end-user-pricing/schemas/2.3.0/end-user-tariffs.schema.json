{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Go-Electra-Public/ocpi-extensions/main/extensions/end-user-pricing/schemas/2.3.0/end-user-tariffs.schema.json",
  "title": "EndUserTariffs (OCPI 2.3.0)",
  "description": "data of GET {end_user_pricing_url}/tariffs/{country_code}/{party_id}/{location_id}[/{evse_uid}[/{connector_id}]] (spec §3.2).",
  "type": "object",
  "properties": {
    "pricing_status": { "$ref": "pricing-status.schema.json" },
    "tariffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/endUserTariff" },
      "description": "One entry per connector of the requested scope the eMSP can price."
    }
  },
  "required": ["pricing_status", "tariffs"],
  "if": {
    "properties": { "pricing_status": { "const": "AVAILABLE" } }
  },
  "else": {
    "properties": { "tariffs": { "maxItems": 0 } },
    "description": "tariffs is empty when pricing_status is not AVAILABLE."
  },
  "$defs": {
    "endUserTariff": {
      "type": "object",
      "properties": {
        "evse_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "EVSE.uid of the requested Location, not its evse_id."
        },
        "connector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "description": "Connector.id within that EVSE."
        },
        "tariff": { "$ref": "tariff.schema.json" }
      },
      "required": ["evse_uid", "connector_id", "tariff"]
    }
  }
}
